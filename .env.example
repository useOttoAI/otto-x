# OKX Onchain OS API credentials
# Get these from: https://web3.okx.com/onchainos/dev-portal
OKX_API_KEY=your-api-key
OKX_SECRET_KEY=your-secret-key
OKX_PASSPHRASE=your-passphrase

# x402 payment recipient address (any EVM address you control on X Layer)
PAY_TO_ADDRESS=0xYourWalletAddress

# Service port
PORT=4196

# (Optional) Backend service URLs for proxied market intelligence + AI endpoints
MARKET_ALPHA_X402_URL=https://your-market-alpha-service.example.com
TOOLS_AGENT_X402_URL=https://your-tools-agent-service.example.com
INTERNAL_API_KEY=your-internal-api-key
